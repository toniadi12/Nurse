# Pakai legacy peer deps karena React 19 ekosistem masih ada banyak package
# yang peer dep-nya belum nyatat React 19 support secara eksplisit
# (terutama transitive react-dom dari Radix/vaul via expo-router web view).
# Bukan masalah runtime — Jaga = React Native, tidak pakai react-dom.
# Lihat memory: audit-decisions.md untuk konteks lengkap.
legacy-peer-deps=true
